---
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
	<header class="header"><slot name="header" /></header>
	{hasSidebar && <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
		<MobileMenuToggle />
		<handbook-sidebar-pane popover="auto" id="starlight__sidebar" class="sidebar-pane">
			<div class="sidebar-content sl-flex"><slot name="sidebar" /></div>
		</handbook-sidebar-pane>
	</nav>}
	<div class="main-frame"><slot /></div>
</div>

<script>
	class HandbookSidebarPane extends HTMLElement {
		#events = new AbortController();

		connectedCallback() {
			this.#events = new AbortController();
			const options = { signal: this.#events.signal };
			this.addEventListener('toggle', () => {
				this.setBackgroundInert(this.matches(':popover-open'));
			}, options);
			this.addEventListener('click', event => {
				if (event.target instanceof Element && event.target.closest('a[href]')) this.hidePopover();
			}, options);
		}

		disconnectedCallback() {
			this.#events.abort();
			this.setBackgroundInert(false);
		}

		setBackgroundInert(inert: boolean) {
			document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach(element => {
				element.inert = inert;
			});
		}
	}

	customElements.define('handbook-sidebar-pane', HandbookSidebarPane);
</script>

<style>
	.page {
		flex-direction: column;
		min-height: 100vh;
	}

	.header {
		z-index: var(--sl-z-index-navbar);
		position: fixed;
		inset-block-start: 0;
		inset-inline-start: 0;
		width: 100%;
		height: var(--sl-nav-height);
		border-bottom: 1px solid var(--sl-color-hairline-shade);
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		background-color: var(--sl-color-bg-nav);
	}

	:global([data-has-sidebar]) .header {
		padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
	}

	.sidebar-pane {
		position: fixed;
		inset-block: var(--sl-nav-height) 0;
		inset-inline: 0 auto;
		margin: 0;
		border: 0;
		border-inline-end: 1px solid var(--sl-color-hairline-shade);
		padding: 0;
		width: 100%;
		height: auto;
		max-height: calc(100dvh - var(--sl-nav-height));
		background-color: var(--sl-color-bg-sidebar);
		color: var(--sl-color-text);
		overflow-y: auto;
		scrollbar-gutter: stable;
		box-shadow: var(--sl-shadow-lg);
	}

	.sidebar-content {
		min-height: 100%;
		padding: 1rem var(--sl-sidebar-pad-x);
		flex-direction: column;
		gap: 1rem;
	}

	.main-frame {
		padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
	}

	@media (min-width: 50rem) {
		.sidebar-pane { width: var(--sl-sidebar-width); }
	}
</style>

<style is:global>
	:root { scrollbar-gutter: stable; }
	:root[data-has-sidebar] { --sl-content-inline-start: 0rem; }

	@media screen {
		.sidebar .sl-menu-button { display: flex; }
		body:has(#starlight__sidebar:popover-open) { overflow: hidden; }
	}
</style>
