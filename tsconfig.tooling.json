{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"checkJs": false,
		"incremental": true,
		"tsBuildInfoFile": "./node_modules/.cache/typescript/tooling.tsbuildinfo",
		"types": [
			"node"
		]
	},
	"include": [
		"src/vite-env.d.ts",
		"vite.config.mjs",
		"playwright.config.mjs",
		"playwright.check-all.config.ts",
		"electron-builder.config.cjs",
		"electron-builder.appx.config.cjs",
		"scripts/performance/*.ts",
		"scripts/audit-hindenburg-import.ts",
		"scripts/audit-reaper-import.ts",
		"scripts/diagnose-windows-make-arguments.ts",
		"scripts/download-translations.ts",
		"scripts/build-assistance-engine-part.ts",
		"scripts/check-all*.ts",
		"scripts/check-module*.ts",
		"scripts/lib/check-all*.ts",
		"scripts/lib/check-module*.ts",
		"scripts/lib/module-*.ts",
		"scripts/lib/ci-artifact-fetch.ts",
		"scripts/lib/handbook-deploy.ts",
		"scripts/docs-comparisons.ts",
		"scripts/lib/handbook-comparisons.ts",
		"scripts/lib/vite-download-page.ts",
		"scripts/run-module-browser-tests.ts",
		"scripts/qualified-node-preload.ts",
		"scripts/lib/qualified-node-*.ts"
	],
	"exclude": [
		"dist",
		"node_modules"
	]
}
