cmake_minimum_required(VERSION 3.28)

# Adapt only owned installed metadata for CMake's ordinary pkg-config consumer.
if(NOT DEFINED FFMPEG_PKG_CONFIG_ROOT OR NOT IS_ABSOLUTE "${FFMPEG_PKG_CONFIG_ROOT}"
    OR NOT IS_DIRECTORY "${FFMPEG_PKG_CONFIG_ROOT}" OR IS_SYMLINK "${FFMPEG_PKG_CONFIG_ROOT}")
    message(FATAL_ERROR "An absolute installed FFmpeg pkg-config directory is required.")
endif()
file(GLOB metadata LIST_DIRECTORIES false "${FFMPEG_PKG_CONFIG_ROOT}/lib*.pc")
if(NOT metadata)
    message(FATAL_ERROR "The installed FFmpeg pkg-config directory contains no library metadata.")
endif()
set(library "(^|[ \t])([A-Za-z0-9_][A-Za-z0-9_.+-]*)\\.lib([ \t]|$)")
function(portable_link_line line output)
    string(REPLACE "-libpath:" "-L" pending "${line}")
    set(result "")
    while(NOT pending STREQUAL "")
        set(quoted "")
        string(REGEX MATCH "[\"']" quote "${pending}")
        if(quote STREQUAL "")
            set(unquoted "${pending}")
            set(pending "")
        else()
            string(FIND "${pending}" "${quote}" start)
            string(SUBSTRING "${pending}" 0 ${start} unquoted)
            math(EXPR after_start "${start} + 1")
            string(SUBSTRING "${pending}" ${after_start} -1 after_quote)
            string(FIND "${after_quote}" "${quote}" end)
            if(end LESS 0)
                message(FATAL_ERROR "Installed FFmpeg link metadata contains an unmatched quote.")
            endif()
            math(EXPR length "${end} + 2")
            string(SUBSTRING "${pending}" ${start} ${length} quoted)
            math(EXPR next "${start} + ${length}")
            string(SUBSTRING "${pending}" ${next} -1 pending)
        endif()
        string(REGEX MATCH "${library}" bare "${unquoted}")
        while(NOT bare STREQUAL "")
            string(REGEX REPLACE "${library}" "\\1-l\\2\\3" unquoted "${unquoted}")
            string(REGEX MATCH "${library}" bare "${unquoted}")
        endwhile()
        string(APPEND result "${unquoted}${quoted}")
    endwhile()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

foreach(path IN LISTS metadata)
    if(IS_SYMLINK "${path}")
        message(FATAL_ERROR "Installed FFmpeg pkg-config metadata must be regular files.")
    endif()
    file(READ "${path}" header)
    set(original_header "${header}")
    file(READ "${path}" header_hex HEX)
    foreach(field IN ITEMS "Libs" "Libs\\.private")
        string(REGEX MATCH "(^|\n)${field}:[^\n]*" link_line "${header}")
        if(NOT link_line STREQUAL "")
            portable_link_line("${link_line}" adapted)
            string(REPLACE "${link_line}" "${adapted}" header "${header}")
        endif()
    endforeach()
    if(NOT header STREQUAL original_header)
        string(FIND "${header_hex}" "0d0a" crlf)
        set(line_endings LF)
        if(NOT crlf LESS 0)
            set(line_endings CRLF)
        endif()
        set(literal_at "@")
        string(REPLACE "@" "@literal_at@" header "${header}")
        file(CONFIGURE OUTPUT "${path}" CONTENT "${header}" @ONLY NEWLINE_STYLE "${line_endings}")
    endif()
endforeach()
