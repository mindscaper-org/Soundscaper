cmake_minimum_required(VERSION 3.28)

# The recipe authenticates and stages upstream FFmpeg before this Windows-only
# adaptation. Keep compiler undefines out of link.exe without hiding its warnings.
if(NOT DEFINED FFMPEG_CONFIGURE_FILE OR NOT IS_ABSOLUTE "${FFMPEG_CONFIGURE_FILE}"
    OR NOT EXISTS "${FFMPEG_CONFIGURE_FILE}" OR IS_DIRECTORY "${FFMPEG_CONFIGURE_FILE}"
    OR IS_SYMLINK "${FFMPEG_CONFIGURE_FILE}")
    message(FATAL_ERROR "An absolute regular staged FFmpeg configure file is required.")
endif()
file(TO_CMAKE_PATH "${FFMPEG_CONFIGURE_FILE}" configure_path)
file(REAL_PATH "${configure_path}" canonical_path)
if(NOT configure_path STREQUAL canonical_path)
    message(FATAL_ERROR "The staged FFmpeg configure path must be canonical.")
endif()
string(LENGTH "${FFMPEG_CONFIGURE_SHA256}" digest_length)
if(NOT digest_length EQUAL 64 OR NOT FFMPEG_CONFIGURE_SHA256 MATCHES "^[a-f0-9]+$")
    message(FATAL_ERROR "The pinned FFmpeg configure SHA256 is required.")
endif()
file(SIZE "${configure_path}" byte_length)
if(byte_length LESS 1 OR byte_length GREATER 524288)
    message(FATAL_ERROR "The staged FFmpeg configure file exceeds its size bound.")
endif()
file(SHA256 "${configure_path}" actual_digest)
if(NOT actual_digest STREQUAL FFMPEG_CONFIGURE_SHA256)
    message(FATAL_ERROR "The staged FFmpeg configure file differs from its pin.")
endif()
file(READ "${configure_path}" original)
string(SHA256 text_digest "${original}")
if(NOT text_digest STREQUAL actual_digest)
    # CMake reads CRLF as LF. Restore it only when that recovers the exact pin.
    string(REPLACE "\n" "\r\n" original "${original}")
    string(SHA256 text_digest "${original}")
    if(NOT text_digest STREQUAL actual_digest)
        message(FATAL_ERROR "The staged FFmpeg configure text has unsupported line endings or encoding.")
    endif()
endif()
set(directive [=[            -D*) [ "$_flags_type" = "link" ] || echo $flag ;;]=])
string(REPLACE "${directive}" "" without_directive "${original}")
string(LENGTH "${original}" original_length)
string(LENGTH "${without_directive}" remainder_length)
string(LENGTH "${directive}" directive_length)
math(EXPR expected_remainder "${original_length} - ${directive_length}")
if(NOT remainder_length EQUAL expected_remainder)
    message(FATAL_ERROR "Exactly one authentic FFmpeg MSVC compiler-only directive is required.")
endif()
string(REPLACE "-D*)" "-D*|-U*)" corrected "${directive}")
string(REPLACE "${directive}" "${corrected}" adapted "${original}")
file(WRITE "${configure_path}" "${adapted}")
