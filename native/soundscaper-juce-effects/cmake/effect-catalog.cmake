# One catalogue supplies both the menu and native descriptors. Generated headers
# stay in the build directory and retain the existing gain/convolution kind IDs.
set(catalog_path "${CMAKE_CURRENT_SOURCE_DIR}/../../src/common/editor/juce-effects/catalog.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${catalog_path}")
file(READ "${catalog_path}" catalog)
string(JSON effect_count LENGTH "${catalog}")
math(EXPR last_effect "${effect_count} - 1")
set(kinds "")
set(effects "")
foreach(index RANGE ${last_effect})
	foreach(field kind code id label)
		string(JSON ${field} GET "${catalog}" ${index} ${field})
	endforeach()
	if(NOT kind MATCHES "^[A-Za-z][A-Za-z0-9]*$" OR NOT id MATCHES "^[a-z][a-z0-9-]*$")
		message(FATAL_ERROR "Invalid JUCE effect identity")
	endif()
	string(APPEND kinds "${kind} = ${code},\n")
	string(JSON parameter_count LENGTH "${catalog}" ${index} parameters)
	if(parameter_count GREATER 8 OR parameter_count LESS 1)
		message(FATAL_ERROR "Invalid JUCE parameter count")
	endif()
	math(EXPR last_parameter "${parameter_count} - 1")
	set(parameters "")
	foreach(parameter RANGE ${last_parameter})
		foreach(field name unit min max initial)
			string(JSON ${field} GET "${catalog}" ${index} parameters ${parameter} ${field})
		endforeach()
		string(JSON logarithmic ERROR_VARIABLE no_log GET "${catalog}" ${index} parameters ${parameter} logarithmic)
		if(no_log OR NOT logarithmic)
			set(logarithmic "false")
		else()
			set(logarithmic "true")
		endif()
		set(choices "")
		string(JSON choice_count ERROR_VARIABLE no_choices LENGTH "${catalog}" ${index} parameters ${parameter} choices)
		if(no_choices)
			set(choice_count 0)
		else()
			math(EXPR last_choice "${choice_count} - 1")
			foreach(choice RANGE ${last_choice})
				string(JSON choice_name GET "${catalog}" ${index} parameters ${parameter} choices ${choice})
				string(APPEND choices "\"${choice_name}\",")
			endforeach()
		endif()
		string(APPEND parameters "ParameterSpec{\"${name}\", \"${unit}\", static_cast<float>(${min}), static_cast<float>(${max}), static_cast<float>(${initial}), ${logarithmic}, {${choices}}, ${choice_count}},\n")
	endforeach()
	string(APPEND effects "EffectSpec{Kind::${kind}, \"org.soundscaper.juce.${id}\", \"JUCE ${label}\", ${parameter_count}, {${parameters}}},\n")
endforeach()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/effect_catalog.generated.h"
	"// Generated from the shared JUCE effect catalogue. SPDX-License-Identifier: AGPL-3.0-only\n#pragma once\nnamespace soundscaper::effects {\nenum class Kind : uint32_t {${kinds}};\nstruct EffectSpec { Kind kind; const char *id; const char *name; uint32_t parameterCount; std::array<ParameterSpec, maximumParameters> parameters; };\ninline constexpr std::array<EffectSpec, ${effect_count}> effectCatalog{{${effects}}};\ninline const EffectSpec &effectSpec(Kind kind) { return effectCatalog.at(static_cast<size_t>(kind) - 1); }\n}\n")
