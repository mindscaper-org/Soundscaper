<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only; generated by scripts/generate-windows-policy-templates.mjs -->
<policyDefinitionResources xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions" revision="1.0" schemaVersion="1.0">
  <displayName>Framescaper policies</displayName><description>Administrator policies for Framescaper</description>
  <resources>
    <stringTable>
      <string id="Application">Framescaper</string>
      <string id="OnlineFeaturesAllowed">Allow online features</string>
      <string id="OnlineFeaturesAllowedHelp">Disabling this policy prohibits application internet features, including updates, downloads, online providers, Web VCR and external links. Local automation has its own policy. Settings are read at application startup. Machine policy takes precedence over user policy. Allowing a feature does not replace user consent.</string>
      <string id="ApplicationUpdatesAllowed">Allow application updates</string>
      <string id="ApplicationUpdatesAllowedHelp">Disabling this policy prohibits automatic and manual update checks, downloads and pending installations. MSI installations always use administrator-managed updates. Settings are read at application startup. Machine policy takes precedence over user policy. Allowing a feature does not replace user consent.</string>
      <string id="ModelDownloadsAllowed">Allow model and runtime downloads</string>
      <string id="ModelDownloadsAllowedHelp">Disabling this policy prohibits downloads of local-assistance models and runtimes. Installed models and offline preseeded installation remain available. Settings are read at application startup. Machine policy takes precedence over user policy. Allowing a feature does not replace user consent.</string>
      <string id="FreesoundAllowed">Allow Freesound</string>
      <string id="FreesoundAllowedHelp">Disabling this policy prohibits Freesound authorization, requests, previews, downloads and uploads. Settings are read at application startup. Machine policy takes precedence over user policy. Allowing a feature does not replace user consent.</string>
      <string id="AudiocomAllowed">Allow audio.com</string>
      <string id="AudiocomAllowedHelp">Disabling this policy prohibits audio.com authorization, requests, previews, downloads, uploads and project synchronization. Settings are read at application startup. Machine policy takes precedence over user policy. Allowing a feature does not replace user consent.</string>
      <string id="WebVcrAllowed">Allow Web VCR</string>
      <string id="WebVcrAllowedHelp">Disabling this policy prohibits the Framescaper Web VCR guest browser. It has no effect in Soundscaper. Settings are read at application startup. Machine policy takes precedence over user policy. Allowing a feature does not replace user consent.</string>
      <string id="ExternalLinksAllowed">Allow external links</string>
      <string id="ExternalLinksAllowedHelp">Disabling this policy prohibits links and authorization handoffs to the system browser. Settings are read at application startup. Machine policy takes precedence over user policy. Allowing a feature does not replace user consent.</string>
      <string id="ExternalCodecInstallationAllowed">Allow external codec installation</string>
      <string id="ExternalCodecInstallationAllowedHelp">Disabling this policy prohibits in-app package-manager installation of FFmpeg. Existing local codecs remain available. Settings are read at application startup. Machine policy takes precedence over user policy. Allowing a feature does not replace user consent.</string>
      <string id="LocalIntegrationsAllowed">Allow local networking integrations</string>
      <string id="LocalIntegrationsAllowedHelp">Disabling this policy prohibits starting the local MCP server and live Blender connections. File-based Blender export remains available. Settings are read at application startup. Machine policy takes precedence over user policy. Allowing a feature does not replace user consent.</string>
      <string id="LaunchPreferences">Reset selected preferences on launch</string>
      <string id="LaunchPreferencesHelp">Apply a versioned JSON preference patch on each application launch. Example: {&quot;schemaVersion&quot;:1,&quot;desktop&quot;:{&quot;updatesEnabled&quot;:false},&quot;editor&quot;:{&quot;appearance&quot;:{&quot;theme&quot;:&quot;dark&quot;}}}. Unspecified settings remain unchanged. Users may change these preferences during the session. On the next launch the patch is reapplied. Machine fields take precedence over user fields. Removing this policy stops resetting values; it does not restore old preferences.</string>
    </stringTable>
    <presentationTable><presentation id="LaunchPreferences"><textBox refId="LaunchPreferences"><label>Preference patch (JSON)</label></textBox></presentation></presentationTable>
  </resources>
</policyDefinitionResources>
